{
  "name": "@carom/protocol",
  "version": "0.1.0",
  "description": "Carom protocol v1 reference implementation: envelopes, records, boxes, pairing, rekey, tokens.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.build.json --noEmit",
    "test": "vitest run",
    "vectors": "node scripts/generate-vectors.ts"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}

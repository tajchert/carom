<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 11 and lower (android:fullBackupContent). allowBackup is false, and these rules
    also exclude every domain so nothing leaks if backup is ever re-enabled. Keys, the device
    token, the outbox and settings are all device-bound (SPEC §5.3, docs/CLIENTS.md).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        Backups are off and every domain is excluded: identity keys, group keys and the device
        token must never leave the device (SPEC §5.3).

        Exported components in the merged manifest, each reviewed:
        - MainActivity (launcher), ShareTargetActivity (ACTION_SEND text/plain, reads nothing but
          the shared text), ClipboardTileService (BIND_QUICK_SETTINGS_TILE) and
          CaromListenerService (BIND_NOTIFICATION_LISTENER_SERVICE);
        - the push libraries: UnifiedPush connector MessagingReceiverImpl and
          RaiseToForegroundService (distributor IPC) and the embedded FCM distributor's
          FirebaseReceiver (c2dm SEND permission);
        - system-only library components: WorkManager SystemJobService (BIND_JOB_SERVICE) and
          ProfileInstallReceiver (DUMP, used to install baseline profiles).
        WorkManager's DiagnosticsReceiver is removed below; nothing uses it.
    -->
    <application
        android:name=".CaromApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Carom">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Carom.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name="androidx.work.impl.diagnostics.DiagnosticsReceiver"
            tools:node="remove" />

        <!-- WorkManager is initialised on demand with the Hilt worker factory (CaromApplication). -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>

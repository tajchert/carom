<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        UnifiedPush events reach this service through the connector's own receiver
        (org.unifiedpush.android.connector.internal.MessagingReceiverImpl, exported by the
        connector library because distributors live in other apps). The embedded FCM distributor
        adds FirebaseReceiver, exported but guarded by com.google.android.c2dm.permission.SEND.
        Our own component is not exported.
    -->
    <application>
        <service
            android:name=".CaromPushService"
            android:exported="false">
            <intent-filter>
                <action android:name="org.unifiedpush.android.connector.PUSH_EVENT" />
            </intent-filter>
        </service>
    </application>

</manifest>

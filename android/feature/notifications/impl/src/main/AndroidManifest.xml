<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Deliberately exported (AGENTS.md): the system binds notification listeners, and only
            holders of BIND_NOTIFICATION_LISTENER_SERVICE (the system) may bind it. The default
            filter asks the system to deliver every type, including ongoing and silent ones
            (Live Updates, progress, calls); our own filters decide what is forwarded (Android 12+;
            older versions deliver everything anyway).
        -->
        <service
            android:name=".CaromListenerService"
            android:exported="true"
            android:label="@string/feature_notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|ongoing|silent" />
        </service>
    </application>

</manifest>

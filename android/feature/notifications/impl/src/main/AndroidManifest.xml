<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Not exported: started by our own prompt notification and by onboarding. -->
        <activity
            android:name=".codes.CodeForwardingActivity"
            android:exported="false"
            android:theme="@style/Theme.CaromCodeForwarding" />

        <!--
            Deliberately exported (AGENTS.md): the system binds notification listeners, and only
            holders of BIND_NOTIFICATION_LISTENER_SERVICE (the system) may bind it. The default
            filter asks the system to deliver only alerting notifications and conversations, so
            silent and ongoing notifications never wake us (Android 12+; older versions deliver
            everything and our own filters drop them).
        -->
        <service
            android:name=".CaromListenerService"
            android:exported="true"
            android:label="@string/feature_notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting" />
        </service>
    </application>

</manifest>

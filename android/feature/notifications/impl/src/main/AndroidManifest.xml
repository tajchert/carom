<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_REMOTE_MESSAGING" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission: lets the watch-profile association grant RECEIVE_SENSITIVE_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.REQUEST_COMPANION_PROFILE_WATCH" />

    <uses-feature
        android:name="android.software.companion_device_setup"
        android:required="false" />

    <application>
        <!-- Not exported: started by our own prompt notification and by onboarding. -->
        <activity
            android:name=".codes.CodeForwardingActivity"
            android:exported="false"
            android:theme="@style/Theme.CaromCodeForwarding" />

        <!-- Not exported: only our own prompt's "Don't show again" action sends it. -->
        <receiver
            android:name=".codes.RedactionPromptMuteReceiver"
            android:exported="false" />

        <!--
            Deliberately exported (AGENTS.md): the system binds notification listeners, and only
            holders of BIND_NOTIFICATION_LISTENER_SERVICE (the system) may bind it. The default
            filter asks the system to deliver every type, including ongoing and silent ones
            (Live Updates, progress, calls); our own filters decide what is forwarded (Android 12+;
            older versions deliver everything anyway).
        -->
        <service
            android:name=".CaromListenerService"
            android:exported="true"
            android:label="@string/feature_notifications_listener_label"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
            <meta-data
                android:name="android.service.notification.default_filter_types"
                android:value="conversations|alerting|ongoing|silent" />
        </service>

        <!-- Not exported: only Carom starts it, when "Actions from Mac" is set to Always. -->
        <service
            android:name=".actions.ActionsForegroundService"
            android:exported="false"
            android:foregroundServiceType="remoteMessaging" />
    </application>

</manifest>

    <string name="feature_pairing_code_title">Scan this code on the new device</string>
    <string name="feature_pairing_code_body">Open Carom on the other device and choose Join with a code.</string>
    <string name="feature_pairing_code_description">QR code for pairing a new device</string>
    <string name="feature_pairing_expires_in">Expires in %1$s</string>
    <string name="feature_pairing_waiting">Waiting for the other device…</string>
    <string name="feature_pairing_copy">Copy code instead</string>
    <string name="feature_pairing_copied">Copied. Paste it on the other device.</string>
    <string name="feature_pairing_clip_label">Carom pairing code</string>


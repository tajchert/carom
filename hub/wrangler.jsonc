{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "carom-hub",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  // Never rename or edit: Durable Object migrations are applied by tag.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "vars": {
    // "" (no constraint) or "eu". Fixed for the life of a deployment: changing it
    // points the Worker at a different, empty Durable Object.
    "HUB_JURISDICTION": ""
  },
  // Approximate per-location limits, checked in the Worker before the Durable Object wakes
  // (SPEC §6). namespace_id only has to be unique within the Cloudflare account.
  "ratelimits": [
    // Unauthenticated routes (info, setup, reset, pair accept), keyed by route and client IP.
    { "name": "ANON_LIMITER", "namespace_id": "730101", "simple": { "limit": 10, "period": 60 } },
    // Authenticated routes, keyed by device id. Clients back off and retry on a plain 429.
    { "name": "DEVICE_LIMITER", "namespace_id": "730102", "simple": { "limit": 300, "period": 60 } }
  ],
  // SETUP_TOKEN is a secret (see .dev.vars.example) and is never set here.
  // Only our own console logs are kept: route names, status codes and error kinds, never payloads
  // or tokens. Invocation logs and traces are off because they record request URLs, which carry
  // pair and blob ids.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}

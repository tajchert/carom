{
  "name": "carom-hub",
  "version": "0.1.0",
  "description": "Carom Hub: Cloudflare Worker + Durable Object that relays end-to-end encrypted notifications and clipboard between your devices",
  "type": "module",
  "files": [
    "src",
    "wrangler.jsonc",
    "tsconfig.json",
    ".dev.vars.example",
    "README.md"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "wrangler": "^4.149.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}

{
  "name": "carom-hub",
  "version": "1.0.2",
  "description": "Carom Hub: Cloudflare Worker + Durable Object that relays end-to-end encrypted notifications and clipboard between your devices",
  "type": "module",
  "files": [
    "bin",
    "!bin/test",
    "src",
    "!src/**/*.test.ts",
    "wrangler.jsonc",
    "tsconfig.json",
    ".dev.vars.example",
    "README.md"
  ],
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types src/worker-configuration.d.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "test": "vitest run && node --test bin/test/",
    "test:worker": "vitest run",
    "test:cli": "node --test bin/test/"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "qrcode-terminal": "^0.12.0",
    "wrangler": "^4.149.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "ws": "^8.21.0"
  },
  "bin": {
    "carom-hub": "bin/carom-hub.mjs"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tajchert/carom",
    "directory": "hub"
  },
  "license": "GPL-3.0-only"
}
